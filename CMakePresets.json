{
  "version": 3,
  "configurePresets": [
    {
      "name": "m32",
      "displayName": "32-bit (PSP struct layout)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/pc-m32",
      "toolchainFile": "${sourceDir}/cmake/toolchain-m32.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "m32-debug",
      "displayName": "32-bit, unoptimized (for the debugger)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/pc-m32-debug",
      "toolchainFile": "${sourceDir}/cmake/toolchain-m32.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64",
      "displayName": "64-bit host build (needs a system SDL3)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/pc-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "m32",
      "configurePreset": "m32"
    },
    {
      "name": "m32-debug",
      "configurePreset": "m32-debug"
    },
    {
      "name": "x64",
      "configurePreset": "x64"
    }
  ]
}
